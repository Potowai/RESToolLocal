# Variables d'environnement — copier en .env.local et compléter.
# NE JAMAIS committer le fichier .env réel.

# Base de données
DB_USER=your_user
DB_HOST=your_host
DB_DATABASE=your_database
DB_PASSWORD=your_password
DB_PORT=5432
DB_URL=postgres://your_user:your_password@your_host:5432/your_database

# Serveur
PORT=3000
